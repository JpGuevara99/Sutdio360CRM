# Public app URL (used in Calendar event notes)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Dominios de Workspace permitidos para entrar (separados por coma).
# OBLIGATORIO: si está vacío, nadie puede iniciar sesión (a propósito, para que
# una variable olvidada no abra el CRM a cualquier cuenta de Google).
ALLOWED_EMAIL_DOMAINS="studio360.cl"

# Correos con rol de administrador, separados por coma. Solo ellos pueden hacer
# las acciones irreversibles: borrar definitivamente o restaurar toda la
# papelera, combinar clientes, eliminar un cliente completo, borrar etapas del
# pipeline y cambiar la configuración global.
# La cuenta de GOOGLE_WORKSPACE_IMPERSONATE_EMAIL siempre es administradora.
ADMIN_EMAILS=""

# Firebase client (public) — Project settings > General > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin (server) — Project settings > Service accounts > Generate new private key
# This also enables Cloud Firestore as the CRM database
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Temporary: set to 1 to use local JSON DB (.data/store.json) and skip Firestore
# Useful when free-tier quota is exhausted. Remember to set back to 0 afterward.
CRM_USE_LOCAL_DB="0"
# Milisegundos que se reutilizan las lecturas de Firestore en memoria (0 = sin
# caché). Toda escritura la invalida al instante; subirlo ahorra más lecturas
# del plan gratuito, bajarlo refresca antes si hay varias instancias.
CRM_DB_CACHE_TTL_MS="30000"
# Google Calendar / Drive / Tasks (service account with Workspace domain-wide delegation)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_WORKSPACE_IMPERSONATE_EMAIL=""
GOOGLE_CALENDAR_ID="primary"
GOOGLE_DRIVE_ROOT_FOLDER_ID=""
# Opcional. Si lo omites, se usa la primera lista de Tasks de la cuenta impersonada.
GOOGLE_TASKS_LIST_ID=""
# En Admin de Workspace → Delegación en todo el dominio, el Client ID debe incluir:
# https://www.googleapis.com/auth/calendar
# https://www.googleapis.com/auth/calendar.events
# https://www.googleapis.com/auth/drive
# https://www.googleapis.com/auth/tasks
# Y en GCP hay que habilitar “Google Tasks API”.

# Protect cron/sync endpoints
CRON_SECRET="change-me"
