# Public app URL (used in Calendar event notes)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Allowed Workspace domain for staff login (comma-separated if multiple)
ALLOWED_EMAIL_DOMAINS="studio360.cl"

# Firebase client (public) — Project settings > General > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin (server) — Project settings > Service accounts > Generate new private key
# This also enables Cloud Firestore as the CRM database
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Temporary: set to 1 to use local JSON DB (.data/store.json) and skip Firestore
# Useful when free-tier quota is exhausted. Remember to set back to 0 afterward.
CRM_USE_LOCAL_DB="0"
# Google Calendar / Drive (service account with Workspace domain-wide delegation)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_WORKSPACE_IMPERSONATE_EMAIL=""
GOOGLE_CALENDAR_ID="primary"
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# Protect cron/sync endpoints
CRON_SECRET="change-me"
